<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>dragonfly.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>Dragonfly</Product>
    <Company>Overtorque Creations</Company>
    <!-- LiveCharts' SkiaSharp/OpenTK dependencies only publish .NET Framework TFMs but run fine on
         net10.0-windows; NU1701 is a false positive for them. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="dragonfly.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.1.0-dev-798" />
    <PackageReference Include="MahApps.Metro.IconPacks.RemixIcon" Version="6.2.1" />
  </ItemGroup>

</Project>
