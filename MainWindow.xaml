<Window x:Class="Dragonfly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dragonfly"
        Title="Dragonfly" Height="820" Width="1240" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Bg2}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,24">
                    <Image x:Name="BrandIcon" Width="34" Height="30" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Dragonfly" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Faint}" Margin="14,8,0,2"/>
                    <Button x:Name="UpdateBanner" Click="UpdateBanner_Click"
                            Visibility="Collapsed" Cursor="Hand" Margin="0,0,0,4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Foreground="{StaticResource Accent}" Background="{StaticResource AccentDim}"
                            BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                                    CornerRadius="6" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="SettingsBtn" Click="Settings_Click"
                            Foreground="{StaticResource TextDim}" Cursor="Hand"
                            Template="{StaticResource NavBtnTemplate}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>
                </StackPanel>

                <StackPanel x:Name="NavPanel" DockPanel.Dock="Top"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl x:Name="ContentHost"/>
        </Grid>
    </Grid>
</Window>
