<UserControl x:Class="Dragonfly.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Dragonfly.Views">
    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Accounts" Style="{StaticResource H1}"/>
                <TextBlock x:Name="SubText" Text="Track your bank accounts, cash, and credit cards." Style="{StaticResource Sub}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,24">
            <StackPanel x:Name="Body"/>
        </ScrollViewer>
    </Grid>
</UserControl>
